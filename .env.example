# --- Application ---
PORT=3000
# URL publique, utilisee pour construire le callback OAuth.
# NE PAS auto-detecter depuis la requete : derriere un reverse proxy l'app voit localhost.
PUBLIC_BASE_URL=https://yoto.exemple.fr
# Fixe, sinon toutes les sessions sautent a chaque redemarrage.
# openssl rand -hex 32
SESSION_SECRET=
# Mot de passe unique d'acces a l'application (l'app detient tes jetons Yoto).
APP_PASSWORD=

# --- Yoto ---
# Client public PKCE enregistre sur https://dashboard.yoto.dev/
# Allowed Callback URL a declarer : {PUBLIC_BASE_URL}/auth/yoto/callback
YOTO_CLIENT_ID=
# Uniquement pour un « Confidential Client ». Laisser vide pour un « Public Client ».
YOTO_CLIENT_SECRET=
# Facultatif : liste de scopes separes par des espaces, a aligner sur ceux coches dans le
# portail Yoto. Retirer offline_access s'il n'y est pas proposable (la session expirera alors).
YOTO_SCOPES=

# --- Stockage ---
DATA_DIR=./data
MEDIA_DIR=./media

# --- Ecriture d'histoires (optionnel) ---
# Cle API DeepSeek : https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# --- Ingestion YouTube (optionnel) ---
# Chemin d'un cookies.txt d'un compte connecte. Indispensable depuis une IP de datacenter.
YTDLP_COOKIES_FILE=
